{
  "name": "pawfare-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de partida de Pawfare (salas Colyseus, 2-4 jugadores, bot de respaldo, reconexión)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/dev/smoke_test.ts",
    "smoke:api": "tsx src/dev/smoke_test_api.ts",
    "smoke:persistence": "tsx src/dev/smoke_test_persistence.ts",
    "smoke:gravity": "tsx src/dev/smoke_test_gravity.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@colyseus/schema": "^4.0.31",
    "colyseus": "^0.17.10",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
